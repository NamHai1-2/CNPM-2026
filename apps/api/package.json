{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"test/db/**\"",
    "migrate": "tsx src/db/migrate.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "reset:password": "tsx src/scripts/reset-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0",
    "postgres": "^3.4.4",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "vitest": "^2.1.0"
  }
}
