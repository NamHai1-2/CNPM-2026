# Copy to .env in the repository ROOT (git-ignored). apps/api and apps/web both read that one file;
# variables already set in the real environment always win over the file.
# ---- apps/api (all values below are FAKE) ----
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://octapoint:octapoint@localhost:5432/octapoint

# Automated tests create a throw-away database on this server for every test file (the ledger
# cannot be truncated, see CLAUDE.md). Any database name works; the role must be allowed to
# CREATE DATABASE and CREATE EXTENSION citext (true for the docker-compose database).
TEST_DATABASE_URL=postgres://octapoint:octapoint@localhost:5432/postgres

# 32 random bytes, base64. Generate once; losing it makes all API secrets unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64

# Sui Testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PRIVATE_KEY=suiprivkey_REPLACE_ME
SUI_PACKAGE_ID=0xREPLACE_ME
SUI_REGISTRY_ID=0xREPLACE_ME
SUI_EXPLORER_TX_URL=https://suiscan.xyz/testnet/tx/{digest}

# true on EXACTLY ONE running instance
ENABLE_ANCHOR_WORKER=false
ANCHOR_INTERVAL_SECONDS=30
ANCHOR_BATCH_SIZE=20

# used only by: pnpm --filter api seed:admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123

# ---- apps/web ----
API_BASE_URL=http://localhost:3001

# ---- packages/mcp and SDK samples ----
OCTAPOINT_BASE_URL=http://localhost:3001
OCTAPOINT_API_KEY=oct_REPLACE_ME
OCTAPOINT_API_SECRET=REPLACE_ME
