+          </Button>
+        }
+      />
+
+      <Card className="overflow-hidden">
+        {error ? (
+          <div className="p-6">
+            <p role="alert" className="text-sm text-red-700">
+              {errorText(error)}
+            </p>
+            <Button variant="outline" size="sm" className="mt-3" onClick={reload}>
+              Try again
+            </Button>
+          </div>
+        ) : (
+          <>
+            <Table>
+              <TableHeader>
+                <TableRow className="hover:bg-transparent">
+                  <TableHead>Name</TableHead>
+                  <TableHead>Email</TableHead>
+                  <TableHead>Status</TableHead>
+                  <TableHead>Added (UTC+7)</TableHead>
+                  <TableHead className="w-32 text-right">Actions</TableHead>
+                </TableRow>
+              </TableHeader>
+              <TableBody>
+                {loading && !data
+                  ? Array.from({ length: 3 }, (_, index) => (
+                      <TableRow key={index} className="hover:bg-transparent">
+                        <TableCell colSpan={5}>
+                          <Skeleton className="h-5 w-full" />
+                        </TableCell>
+                      </TableRow>
+                    ))
+                  : data?.items.map((item) => (
+                      <TableRow key={item.id} className={cn(loading && 'opacity-60')}>
+                        <TableCell className="font-medium">{item.full_name}</TableCell>
+                        <TableCell className="text-muted-foreground">{item.email}</TableCell>
+                        <TableCell>
+                          <Badge variant={item.is_active ? 'success' : 'neutral'} dot>
+                            {item.is_active ? 'Active' : 'Inactive'}
+                          </Badge>
+                        </TableCell>
+                        <TableCell className="whitespace-nowrap text-muted-foreground">
+                          {formatDateTime(item.created_at)}
+                        </TableCell>
+                        <TableCell className="text-right">
+                          {item.is_active ? (
+                            <Button
+                              variant="ghost"
+                              size="sm"
+                              className="text-red-700 hover:text-red-800"
+                              onClick={() => setTarget(item)}
+                            >
+                              Deactivate
+                            </Button>
+                          ) : null}
+                        </TableCell>
+                      </TableRow>
+                    ))}
+              </TableBody>
+            </Table>
+
+            {data && data.items.length === 0 ? (
+              <EmptyState
+                icon={UserCog}
+                title="No staff accounts yet"
+                description="Add a cashier so they can sign in and serve customers."
+              />
+            ) : null}
+
+            {data ? (
+              <Pagination
+                page={data.page}
+                pageSize={data.page_size}
+                total={data.total}
+                onPageChange={setPage}
+                disabled={loading}
+              />
+            ) : null}
+          </>
+        )}
+      </Card>
+
+      <AddStaffDialog
+        open={adding}
+        onOpenChange={setAdding}
+        onCreated={() => {
+          setAdding(false);
+          setPage(1);
+          reload();
+        }}
+      />
+
+      <ConfirmDialog
+        open={target !== null}
+        onOpenChange={(open) => {
+          if (!open) setTarget(null);
+        }}
+        title="Deactivate this staff account?"
